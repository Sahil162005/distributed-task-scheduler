{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			]
		},
		{
			"label": "Type check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"type-check"
			]
		},
		{
			"label": "Install dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			]
		},
		{
			"label": "Type check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"type-check"
			]
		},
		{
			"label": "Install backend deps",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			]
		},
		{
			"label": "Install frontend deps via root",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"cd frontend && npm install"
			]
		},
		{
			"label": "Backend type-check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"type-check"
			]
		},
		{
			"label": "Frontend type-check",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"cd frontend && npm run type-check"
			]
		},
		{
			"label": "Frontend build",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"cd frontend && npm run build"
			]
		},
		{
			"label": "Backend E2E HTTP harness",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"test:e2e:http"
			]
		},
		{
			"label": "Run all backend checks",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"npm install && npm run type-check && npm run test:e2e:http"
			]
		},
		{
			"label": "Run all frontend checks",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"cd frontend && npm install && npm run type-check && npm run build"
			]
		}
	]
}